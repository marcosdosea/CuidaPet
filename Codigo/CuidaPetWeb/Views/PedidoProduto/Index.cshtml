@model IEnumerable<CuidaPetWeb.Models.PedidoProdutoViewModel>

@{
	ViewData["Title"] = "Index";
}

<h1>Produtos</h1>

<table class="table">
	<thead>
		<tr>
			<th>
				@Html.DisplayNameFor(model => model.Id)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.TutorNome)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.RealizadoEm)
			</th>
			<th>
				@Html.DisplayNameFor(model => model.Status)
			</th>
			
			<th></th>
		</tr>
	</thead>
	<tbody>

		@foreach (var item in Model)
		{
			<tr>
				<td>
					@Html.DisplayFor(modelItem => item.Id)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.TutorNome)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.RealizadoEm)
				</td>
				<td>
					@Html.DisplayFor(modelItem => item.Status)
				</td>
				<td>
					@Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
					@Html.ActionLink("Details", "Details", new { id = item.Id }) |
					@Html.ActionLink("Delete", "Delete", new { id = item.Id })
				</td>
			</tr>
		}
	</tbody>
</table>