@model IEnumerable<CuidaPetWeb.Models.EspecieViewModel>

@{
    ViewData["Title"] = "Index";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">Espécies</h2>
    <div class="d-flex align-items-center">
        <a href="/Especie/Create" class="btn-add me-3" title="Adicionar Espécie">
            <i class="bi bi-plus"></i>
        </a>
        <div class="input-group">
            <input type="text" class="form-control" placeholder="Pesquisar">
            <button class="btn btn-outline-secondary">
                <i class="bi bi-search"></i>
            </button>
        </div>
    </div>
</div>

<div class="table-responsive table-custom">
    <table class="table align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th>Nº <i class="bi bi-arrow-down-up"></i></th>
                <th>Espécie <i class="bi bi-arrow-down-up"></i></th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var especie in Model)
            {
                <tr>
                    <td>@especie.Id</td>
                    <td>@especie.Nome</td>
                    <td>
                        <i class="bi bi-eye-fill icon-action icon-view"></i>
                        <i class="bi bi-pencil-fill icon-action icon-edit"></i>
                        <i class="bi bi-trash-fill icon-action icon-delete"></i>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
