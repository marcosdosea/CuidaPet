@model CuidaPetWeb.Models.EspecieViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Criar</h1>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Cadastrar Espécie</h2>
    <a asp-action="Index" class="btn btn-success rounded-circle">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-arrow-left-circle-fill" viewBox="0 0 16 16">
            <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z" />
        </svg>
    </a>
</div>

<form asp-action="Create" method="post" class="w-75 mx-auto">
    <div class="mb-4">
        <input asp-for="Nome" class="form-control form-control-lg rounded-3" placeholder="Nome da Espécie" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="text-center">
        <button type="submit" class="btn btn-success px-5 py-2 rounded-pill fw-bold">
            Cadastrar
        </button>
    </div>
</form>

<div>
    <a asp-action="Index">Voltar para Lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
