@model CuidaPetWeb.Models.EspecieViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Criar</h1>

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="fw-bold">Cadastrar Espécie</h2>
    <a asp-action="Index" class="btn btn-success rounded-circle">
        <i class="bi bi-arrow-left"></i>
    </a>
</div>

<form asp-action="Create" method="post" class="w-75 mx-auto">
    <div class="mb-4">
        <input asp-for="Nome" class="form-control form-control-lg rounded-3" placeholder="Nome da Espécie" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="mb-4">
        <textarea asp-for="Descricao" class="form-control form-control-lg rounded-3" rows="5" placeholder="Descrição"></textarea>
        <span asp-validation-for="Descricao" class="text-danger"></span>
    </div>

    <div class="text-center">
        <button type="submit" class="btn btn-success px-5 py-2 rounded-pill fw-bold">
            Cadastrar
        </button>
    </div>
</form>

<div>
    <a asp-action="Index">Voltar para Lista</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
