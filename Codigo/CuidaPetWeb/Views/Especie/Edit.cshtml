@model CuidaPetWeb.Models.EspecieViewModel

@{
	ViewData["Title"] = "Editar Espécie";
}

<article class="d-flex justify-content-between align-items-center mb-3">
	<h2 class="fw-bold">@ViewData["Title"]</h2>

	<div class="d-flex gap-2">
		<a asp-action="Index" title="Voltar para Lista" class="btn-green-primary d-flex align-items-center">
			<i class="bi bi-arrow-left-circle-fill" style="font-size: 40px;"></i>
		</a>

	</div>
</article>

<section class="bg-gray-light p-4 rounded">
    <div class="d-flex justify-content-center">
        <div class="col-md-8">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <input asp-for="Id" type="hidden" />
                <div class="mb-3 d-flex justify-content-center">
                    <div class="col-md-6">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                </div>
                <div class="d-flex gap-2 mt-4 justify-content-center">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-2"></i>Salvar Alterações
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle me-2"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
}
