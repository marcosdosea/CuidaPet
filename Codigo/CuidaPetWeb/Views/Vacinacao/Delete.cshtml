@model CuidaPetWeb.Models.VacinacaoViewModel

@{
    ViewData["Title"] = "Deletar Vacinação";
}

<article class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">@ViewData["Title"]</h2>

    <div class="d-flex gap-2">
        <a asp-action="Index" title="Voltar para Lista" class="btn-green-primary d-flex align-items-center">
            <i class="bi bi-arrow-left-circle-fill" style="font-size: 40px;"></i>
        </a>
    </div>
</article>

<section class="bg-gray-light p-4 rounded">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="alert alert-warning" role="alert">
                <h5 class="alert-heading">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmação de Exclusão
                </h5>
                <p class="mb-0">Você tem certeza que deseja deletar este registro de vacinação? Esta ação não pode ser desfeita.</p>
            </div>

            <div class="card">
                <div class="card-header bg-gray-medium">
                    <h5 class="card-title mb-0">Vacinação a ser deletada #@Model.Id</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.DataVacina)</dt>
                        <dd class="col-sm-9">@Model.DataVacina.ToString("dd/MM/yyyy")</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Lote)</dt>
                        <dd class="col-sm-9">@(string.IsNullOrEmpty(Model.Lote) ? "Não informado" : Model.Lote)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IdVacina)</dt>
                        <dd class="col-sm-9">
                            @{
                                var vacinas = ViewBag.Vacinas as Dictionary<uint, string>;
                                @(vacinas != null && vacinas.ContainsKey(Model.IdVacina) ? vacinas[Model.IdVacina] : Model.IdVacina.ToString())
                            }
                        </dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IdPet)</dt>
                        <dd class="col-sm-9">
                            @{
                                var pets = ViewBag.Pets as Dictionary<uint, string>;
                                @(pets != null && pets.ContainsKey(Model.IdPet) ? pets[Model.IdPet] : Model.IdPet.ToString())
                            }
                        </dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IdFuncionario)</dt>
                        <dd class="col-sm-9">
                            @{
                                var funcionarios = ViewBag.Funcionarios as Dictionary<uint, string>;
                                @(funcionarios != null && funcionarios.ContainsKey(Model.IdFuncionario) ? funcionarios[Model.IdFuncionario] : Model.IdFuncionario.ToString())
                            }
                        </dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IdTutor)</dt>
                        <dd class="col-sm-9">
                            @{
                                var tutores = ViewBag.Tutores as Dictionary<uint, string>;
                                @(tutores != null && tutores.ContainsKey(Model.IdTutor) ? tutores[Model.IdTutor] : Model.IdTutor.ToString())
                            }
                        </dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <form asp-action="Delete" class="d-inline">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash-fill me-2"></i>Confirmar Exclusão
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
