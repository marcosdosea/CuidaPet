@model CuidaPetWeb.Models.VacinaViewModel

@{
    ViewData["Title"] = "Cadastrar Vacina";
}

<article class="d-flex justify-content-between align-items-center mb-3">
	<h2 class="fw-bold">@ViewData["Title"]</h2>
    
	<a asp-action="Index" title="Adicionar nova vacina" class="btn-green-primary">
        <svg xmlns="http://www.w3.org/2000/svg" width="25" fill="currentColor" class="bi bi-arrow-left-circle-fill" viewBox="0 0 16 16">
            <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0m3.5 7.5a.5.5 0 0 1 0 1H5.707l2.147 2.146a.5.5 0 0 1-.708.708l-3-3a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L5.707 7.5z"/>
        </svg>
    </a>
</article>
<div class="container mt-5" style="padding: 0;">
    <form asp-action="Create">
        <div class="row g-3 mb-4">
            <div class="col-md-3">
                <label  asp-for="Nome" class="form-label visually-hidden">Digite a Vacina</label>
                <input asp-for="Nome" type="text" class="form-control" placeholder="Digite a Vacina">
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="IdEspecie" class="form-label visually-hidden">Selecione Espécie Alvo</label>
                <select asp-for="IdEspecie" asp-items="ViewBag.Especies" class="form-select">
                    <option selected>Selecione Espécie Alvo</option>
                </select>
                <span asp-validation-for="IdEspecie" class="text-danger"></span>
            </div>
            
            <div class="col-md-3">
                <label asp-for="IdDoenca" class="form-label visually-hidden">Selecione a Doença</label>
                <select asp-for="IdDoenca" asp-items="ViewBag.Doencas" class="form-select">
                    <option value="">Selecione Doença</option>
                </select>
                <span asp-validation-for="IdDoenca" class="text-danger"></span>
            </div>
            <div class="col-md-3">
                <label asp-for="PeriodoEmDias" class="form-label visually-hidden">Digite Intervalo de Reforço (Em dias)</label>
                <input asp-for="PeriodoEmDias" type="number" class="form-control" placeholder="Ex.: 365">
                <span asp-validation-for="PeriodoEmDias" class="text-danger"></span>
            </div>
        </div>
        <div class="d-grid gap-2 col-2 mx-auto">
            <button type="submit" class="btn btn-success rounded">Cadastrar</button>
        </div>
    </form>
</div>
