@model CuidaPetWeb.Models.RacaViewModel

@{
    ViewData["Title"] = "Deletar Raça";
}

<article class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">@ViewData["Title"]</h2>

    <div class="d-flex gap-2">
        <a asp-action="Index" title="Voltar para Lista" class="btn-green-primary d-flex align-items-center">
            <i class="bi bi-arrow-left-circle-fill" style="font-size: 40px;"></i>
        </a>
    </div>
</article>

<section class="bg-gray-light p-4 rounded">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="alert alert-warning" role="alert">
                <h5 class="alert-heading">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmação de Exclusão
                </h5>
                <p class="mb-0">Você tem certeza que deseja deletar esta raça? Esta ação não pode ser desfeita.</p>
            </div>

            <div class="card">
                <div class="card-header bg-gray-medium">
                    <h5 class="card-title mb-0">Raça a ser deletada #@Model.Id</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nome)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nome)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IdEspecie)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.IdEspecie)</dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <form asp-action="Delete" class="d-inline">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash-fill me-2"></i>Confirmar Exclusão
                            </button>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-x-circle me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>
