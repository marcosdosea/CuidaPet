@model CuidaPetWeb.Models.PetViewModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Deletar Pet</h1>

<h3>Você tem certeza que quer deletar o pet?</h3>
<div>
    <h4>PetViewModel</h4>
    <hr />
    <dl class="row">
