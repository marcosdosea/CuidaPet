@model CuidaPetWeb.Models.DoencaViewModel

@{
    ViewData["Title"] = "Detalhes da Doença";
}

<article class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">@ViewData["Title"]</h2>

    <div class="d-flex gap-2">
        <a asp-action="Index" title="Voltar para Lista" class="btn-green-primary d-flex align-items-center">
            <i class="bi bi-arrow-left-circle-fill" style="font-size: 40px;"></i>
        </a>
    </div>
</article>

<section class="bg-gray-light p-4 rounded">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-gray-medium">
                    <h5 class="card-title mb-0">Informações da Doença #@Model.Id</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nome)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nome)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IdEspecie)</dt>
                        <dd class="col-sm-9">
                            @{
                                var especies = ViewBag.Especies as Dictionary<uint, string>;
                                @(especies != null && especies.ContainsKey(Model.IdEspecie) ? especies[Model.IdEspecie] : Model.IdEspecie.ToString())
                            }
                        </dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil-fill me-2"></i>Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="bi bi-trash-fill me-2"></i>Deletar
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-list me-2"></i>Voltar para Lista
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
