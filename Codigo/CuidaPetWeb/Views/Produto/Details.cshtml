@model CuidaPetWeb.Models.ProdutoViewModel

@{
    ViewData["Title"] = "Detalhes do Produto";
}

<article class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">@ViewData["Title"]</h2>

    <div class="d-flex gap-2">
        <a asp-action="Index" title="Voltar para Lista" class="btn-green-primary d-flex align-items-center">
            <i class="bi bi-arrow-left-circle-fill" style="font-size: 40px;"></i>
        </a>

    </div>
</article>

<section class="bg-gray-light p-4 rounded">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-gray-medium">
                    <h5 class="card-title mb-0">Informações do Produto #@Model.Id</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nome)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nome)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Preco)</dt>
                        <dd class="col-sm-9">R$ @Model.Preco.ToString("F2")</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Status)</dt>
                        <dd class="col-sm-9">
                            @if (Model.Status == "P")
                            {
                                <span class="badge" style="background-color: #8A6EE6; color: white;">Em Promoção</span>
                            }
                            else if (Model.Status == "D")
                            {
                                <span class="badge" style="background-color: #7BC67B; color: white;">Disponível</span>
                            }
                            else if (Model.Status == "I")
                            {
                                <span class="badge" style="background-color: #F87171; color: white;">Indisponível</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@Model.Status</span>
                            }
                        </dd>

                        @if (Model.PrecoPromocao.HasValue)
                        {
                            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.PrecoPromocao)</dt>
                            <dd class="col-sm-9">R$ @Model.PrecoPromocao.Value.ToString("F2")</dd>
                        }

                        @if (!string.IsNullOrEmpty(Model.Descricao))
                        {
                            <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Descricao)</dt>
                            <dd class="col-sm-9">@Html.DisplayFor(model => model.Descricao)</dd>
                        }

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IdCategoria)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.IdCategoria)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IdEstabelecimento)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.IdEstabelecimento)</dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil-fill me-2"></i>Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="bi bi-trash-fill me-2"></i>Deletar
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-list me-2"></i>Voltar para Lista
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>