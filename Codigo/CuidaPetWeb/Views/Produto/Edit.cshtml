@model CuidaPetWeb.Models.ProdutoViewModel

@{
    ViewData["Title"] = "Editar Produto";
}

<article class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">@ViewData["Title"]</h2>

    <div class="d-flex gap-2">
        <a asp-action="Index" title="Voltar para Lista" class="btn-green-primary d-flex align-items-center">
            <i class="bi bi-arrow-left-circle-fill" style="font-size: 40px;"></i>
        </a>

    </div>
</article>

<section class="bg-gray-light p-4 rounded">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <form asp-action="Edit">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <input asp-for="Id" type="hidden" />

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Nome" class="form-label"></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="Preco" class="form-label"></label>
                        <input asp-for="Preco" class="form-control" />
                        <small class="form-text text-muted">Use vírgula para decimal (ex: 30,29)</small>
                        <span asp-validation-for="Preco" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Status" class="form-label"></label>
                        <select asp-for="Status" class="form-select">
                            <option value="">Selecione o status</option>
                            <option value="D">Disponível</option>
                            <option value="I">Indisponível</option>
                            <option value="P">Em Promoção</option>
                        </select>
                        <span asp-validation-for="Status" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="PrecoPromocao" class="form-label"></label>
                        <input asp-for="PrecoPromocao" class="form-control" />
                        <small class="form-text text-muted">Use vírgula para decimal (ex: 25,50)</small>
                        <span asp-validation-for="PrecoPromocao" class="text-danger"></span>
                    </div>
                </div>

                <div class="mb-3">
                    <label asp-for="Descricao" class="form-label"></label>
                    <textarea asp-for="Descricao" class="form-control" rows="3"></textarea>
                    <span asp-validation-for="Descricao" class="text-danger"></span>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdCategoria" class="form-label"></label>
                        <select asp-for="IdCategoria" asp-items="ViewBag.Categorias" class="form-select">
                            <option value="">Selecione a Categoria</option>
                        </select>
                        <span asp-validation-for="IdCategoria" class="text-danger"></span>
                    </div>
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdEstabelecimento" class="form-label"></label>
                        <select asp-for="IdEstabelecimento" asp-items="ViewBag.Estabelecimentos" class="form-select">
                            <option value="">Selecione o Estabelecimento</option>
                        </select>
                        <span asp-validation-for="IdEstabelecimento" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 mt-4">
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-2"></i>Salvar Alterações
                    </button>
                    <a asp-action="Index" class="btn btn-secondary">
                        <i class="bi bi-x-circle me-2"></i>Cancelar
                    </a>
                </div>
            </form>
        </div>
    </div>
</section>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}