@model IEnumerable<CuidaPetWeb.Models.ProdutoViewModel>

@{
    ViewData["Title"] = "Produtos";
}

<article class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">@ViewData["Title"]</h2>

    <div class="d-flex gap-2">
        <a asp-controller="Home" asp-action="Index" title="Voltar para Home" class="btn-green-primary d-flex align-items-center">
            <i class="bi bi-arrow-left-circle-fill" style="font-size: 40px;"></i>
        </a>

        <a asp-action="Create" title="Adicionar novo produto" class="btn-green-primary d-flex align-items-center">
            <i class="bi bi-plus-circle-fill" style="font-size: 40px;"></i>
        </a>
    </div>
</article>

<section class="bg-gray-light pt-2 rounded">
    <section class="input-group w-25 ms-auto mb-2 px-2">
        <input type="text" id="searchInput" class="form-control" placeholder="Pesquisar">
        <button class="btn btn-outline-secondary" onclick="filterTable()">
            <i class="bi bi-search" style="font-size: 16px;"></i>
        </button>
    </section>

    <div class="table-responsive table-custom">
        <table class="table align-middle mb-0" id="table">
            <thead class="bg-gray-medium">
                <tr>
                    <th style="cursor: pointer;" onclick="sortTable(0, 'number')">
                        Nº
                        <span class="sort-arrows">
                            <i class="bi bi-caret-up-fill" style="font-size: 12px;"></i>
                            <i class="bi bi-caret-down-fill" style="font-size: 12px;"></i>
                        </span>
                    </th>
                    <th style="cursor: pointer;" onclick="sortTable(1, 'text')">
                        Nome
                        <span class="sort-arrows">
                            <i class="bi bi-caret-up-fill" style="font-size: 12px;"></i>
                            <i class="bi bi-caret-down-fill" style="font-size: 12px;"></i>
                        </span>
                    </th>
                    <th style="cursor: pointer;" onclick="sortTable(2, 'text')">
                        Categoria
                        <span class="sort-arrows">
                            <i class="bi bi-caret-up-fill" style="font-size: 12px;"></i>
                            <i class="bi bi-caret-down-fill" style="font-size: 12px;"></i>
                        </span>
                    </th>
                    <th style="cursor: pointer;" onclick="sortTable(3, 'number')">
                        Preço
                        <span class="sort-arrows">
                            <i class="bi bi-caret-up-fill" style="font-size: 12px;"></i>
                            <i class="bi bi-caret-down-fill" style="font-size: 12px;"></i>
                        </span>
                    </th>
                    <th style="cursor: pointer;" onclick="sortTable(4, 'status')">
                        Status
                        <span class="sort-arrows">
                            <i class="bi bi-caret-up-fill" style="font-size: 12px;"></i>
                            <i class="bi bi-caret-down-fill" style="font-size: 12px;"></i>
                        </span>
                    </th>
                    <th>
                        Ações
                    </th>
                </tr>
            </thead>
            <tbody>
                @foreach (var produto in Model) {
                    <tr>
                        <td>@produto.Id</td>
                        <td>@produto.Nome</td>
                        <td>@produto.IdCategoria</td>
                        <td>R$ @produto.Preco.ToString("F2")</td>
                        <td>
                            @if (produto.Status == "P")
                            {
                                <span class="badge" style="background-color: #8A6EE6; color: white;">Em Promoção</span>
                            }
                            else if (produto.Status == "D")
                            {
                                <span class="badge" style="background-color: #7BC67B; color: white;">Disponível</span>
                            }
                            else if (produto.Status == "I")
                            {
                                <span class="badge" style="background-color: #F87171; color: white;">Indisponível</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">@produto.Status</span>
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@produto.Id" class="text-decoration-none" title="Detalhes">
                                <i class="bi bi-eye-fill icon-action icon-view" style="font-size: 20px; color: blue;"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@produto.Id" class="text-decoration-none ms-2" title="Editar">
                                <i class="bi bi-pencil-fill icon-action icon-edit" style="font-size: 16px; color: green;"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@produto.Id" class="text-decoration-none ms-2" title="Deletar">
                                <i class="bi bi-trash-fill icon-action icon-delete" style="font-size: 16px; color: red;"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</section>

@section Scripts {
    <script src="~/js/sortTable.js" defer></script>
}
