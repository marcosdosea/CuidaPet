@model IEnumerable<CuidaPetWeb.Models.FuncionarioViewModel>

@{
    ViewData["Title"] = "Funcionários";
}

<h1>Funcionários</h1>

<p>
    <a asp-action="Create">Novo Funcionário</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.Id)</th>
            <th>@Html.DisplayNameFor(model => model.Crmv)</th>
            <th>@Html.DisplayNameFor(model => model.IdPessoa)</th>
            <th>@Html.DisplayNameFor(model => model.IdEstabelecimento)</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
    <tr>
        <td>@Html.DisplayFor(modelItem => item.Id)</td>
        <td>@Html.DisplayFor(modelItem => item.Crmv)</td>
        <td>@Html.DisplayFor(modelItem => item.IdPessoa)</td>
        <td>@Html.DisplayFor(modelItem => item.IdEstabelecimento)</td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id = item.Id }) |
            @Html.ActionLink("Details", "Details", new { id = item.Id }) |
            @Html.ActionLink("Delete", "Delete", new { id = item.Id })
        </td>
    </tr>
}
    </tbody>
</table>

<div class="d-flex justify-content-between p-2">
    <div class="p-2">
        <span class="fw-bold">Total de Funcionários: </span> @ViewBag.TotalItems
    </div>
    <nav aria-label="Page navigation">
        <ul class="pagination">
            @{
                int TotalItems = ViewBag.TotalItems;
                int pageSize = ViewBag.PageSize;
                int currentPage = ViewBag.Page;
                int totalPages = (int)Math.Ceiling((double)TotalItems / pageSize);

                int maxPagesToShow = 5;
                int startPage = Math.Max(1, currentPage - maxPagesToShow / 2);
                int endPage = Math.Min(totalPages, startPage + maxPagesToShow - 1);

                if (endPage - startPage < maxPagesToShow - 1)
                {
                    startPage = Math.Max(1, endPage - maxPagesToShow + 1);
                }
            }

            <li class="page-item @(currentPage == 1 ? "disabled" : "")">
                <a class="page-link text-primary" asp-action="Index" asp-route-page="@(currentPage - 1)" asp-route-pageSize="@pageSize" aria-label="Previous">
                    <span aria-hidden="true">&laquo;</span>
                </a>
            </li>

            @for (int i = startPage; i <= endPage; i++)
            {
                <li class="page-item @(i == currentPage ? "active" : "")">
                    <a class="page-link text-primary" asp-action="Index" asp-route-page="@i" asp-route-pageSize="@pageSize">@i</a>
                </li>
            }

            <li class="page-item @(currentPage == totalPages ? "disabled" : "")">
                <a class="page-link text-primary" asp-action="Index" asp-route-page="@(currentPage + 1)" asp-route-pageSize="@pageSize" aria-label="Next">
                    <span aria-hidden="true">&raquo;</span>
                </a>
            </li>
        </ul>
    </nav>
</div>
