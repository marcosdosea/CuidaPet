@model CuidaPetWeb.Models.FuncionarioViewModel

@{
    ViewData["Title"] = "Deletar Funcionário";
}

<article class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="fw-bold">@ViewData["Title"]</h2>

    <div class="d-flex gap-2">
        <a asp-action="Index" title="Voltar para Lista" class="btn-green-primary d-flex align-items-center">
            <i class="bi bi-arrow-left-circle-fill" style="font-size: 40px;"></i>
        </a>
    </div>
</article>

<section class="bg-gray-light p-4 rounded">
    <div class="row justify-content-center">
        <div class="col-md-10">
            <div class="card border-danger">
                <div class="card-header bg-danger text-white">
                    <h5 class="card-title mb-0">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        Confirmar Exclusão
                    </h5>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning" role="alert">
                        <strong>Atenção!</strong> Tem certeza que deseja deletar este funcionário? Esta ação não pode ser desfeita.
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <dl class="row">
                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Id)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Id)</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Nome)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Nome)</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Cpf)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Cpf)</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Email)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Email)</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Telefone)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Telefone)</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Tipo)</dt>
                                <dd class="col-sm-8">
                                    @if (Model.Tipo == "A")
                                    {
                                        <span class="badge bg-info">Atendente</span>
                                    }
                                    else if (Model.Tipo == "V")
                                    {
                                        <span class="badge bg-primary">Veterinário</span>
                                    }
                                </dd>

                                @if (Model.Tipo == "V" && !string.IsNullOrEmpty(Model.Crmv))
                                {
                                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Crmv)</dt>
                                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Crmv)</dd>
                                }

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Status)</dt>
                                <dd class="col-sm-8">
                                    @if (Model.Status == "A")
                                    {
                                        <span class="badge bg-success">Ativo</span>
                                    }
                                    else if (Model.Status == "I")
                                    {
                                        <span class="badge bg-danger">Inativo</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold mb-3">
                            <dl class="row">
                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Logradouro)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Logradouro), @Html.DisplayFor(model => model.Numero)</dd>

                                @if (!string.IsNullOrEmpty(Model.Complemento))
                                {
                                    <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Complemento)</dt>
                                    <dd class="col-sm-8">@Html.DisplayFor(model => model.Complemento)</dd>
                                }

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Bairro)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Bairro)</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Cidade)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Cidade)</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.Estado)</dt>
                                <dd class="col-sm-8">@Html.DisplayFor(model => model.Estado)</dd>

                                <dt class="col-sm-4">@Html.DisplayNameFor(model => model.IdEstabelecimento)</dt>
                                <dd class="col-sm-8">
                                    @{
                                        var estabelecimentos = ViewBag.Estabelecimentos as Dictionary<uint, string>;
                                        @(estabelecimentos != null && estabelecimentos.ContainsKey(Model.IdEstabelecimento) ? estabelecimentos[Model.IdEstabelecimento] : Model.IdEstabelecimento.ToString())
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="card-footer">
                    <form asp-action="Delete">
                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash-fill me-2"></i>Confirmar Exclusão
                            </button>
                            <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-info">
                                <i class="bi bi-eye me-2"></i>Ver Detalhes
                            </a>
                            <a asp-action="Index" class="btn btn-secondary">
                                <i class="bi bi-arrow-left me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</section>