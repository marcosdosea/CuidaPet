@model CuidaPetWeb.Models.FuncionarioViewModel

@{
    ViewData["Title"] = "Detalhes";
}

<h1>Detalhes do Funcionário</h1>
<hr />
<dl class="row">
    <dt class="col-sm-2">Nome</dt>
    <dd class="col-sm-10">@Model.Nome</dd>
    <dt class="col-sm-2">CPF</dt>
    <dd class="col-sm-10">@Model.Cpf</dd>
    <dt class="col-sm-2">Email</dt>
    <dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">Telefone</dt>
    <dd class="col-sm-10">@Model.Telefone</dd>
    <dt class="col-sm-2">Tipo</dt>
    <dd class="col-sm-10">@Model.Tipo</dd>
    @if (Model.Tipo == "V")
    {
        <dt class="col-sm-2">CRMV</dt>
        <dd class="col-sm-10">@Model.Crmv</dd>
    }
    <dt class="col-sm-2">Status</dt>
    <dd class="col-sm-10">@Model.Status</dd>
    <dt class="col-sm-2">Endereço</dt>
    <dd class="col-sm-10">@Model.Logradouro, @Model.Numero, @Model.Complemento</dd>
    <dt class="col-sm-2">Bairro</dt>
    <dd class="col-sm-10">@Model.Bairro</dd>
    <dt class="col-sm-2">Cidade</dt>
    <dd class="col-sm-10">@Model.Cidade</dd>
    <dt class="col-sm-2">Estado</dt>
    <dd class="col-sm-10">@Model.Estado</dd>
</dl>
<div>
    @Html.ActionLink("Edit", "Edit", new { id = Model.Id }) |
    <a asp-action="Index">Voltar</a>
</div>