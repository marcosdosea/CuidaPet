<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CuidaPetWeb</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CuidaPetWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Cabeçalho -->
    <header class="bg-success d-flex justify-content-between align-items-center p-3">
        <div>
            <button class="btn btn-light rounded-circle" id="btnMenu">
                <i class="bi bi-arrow-right"></i>
            </button>
        </div>
        <div class="d-flex align-items-center">
            <div class="me-2 text-white text-end">
                <div class="fw-bold">Marcos B. Dósea</div>
                <small>Administrador</small>
            </div>
            <div class="bg-white rounded-circle p-2">
                <i class="bi bi-person fs-4 text-success"></i>
            </div>
        </div>
    </header>

    <div class="d-flex">
        <!-- Menu lateral -->
        <nav id="sidebar" class="sidebar bg-light">
            <button class="btn-close m-3" id="closeMenu"></button>
            <ul class="list-unstyled p-3">
                <li><a href="/Estabelecimentos" class="d-flex align-items-center mb-3"><i class="bi bi-building me-2"></i> Estabelecimentos</a></li>
                <li><a href="/Racas" class="d-flex align-items-center mb-3"><i class="bi bi-paw me-2"></i> Raças</a></li>
                <li><a href="/Vacinas" class="d-flex align-items-center mb-3"><i class="bi bi-syringe me-2"></i> Vacinas</a></li>
                <li><a href="/Especie" class="d-flex align-items-center mb-3"><i class="bi bi-paw-fill me-2"></i> Espécies</a></li>
                <li><a href="/Doenca" class="d-flex align-items-center"><i class="bi bi-thermometer-half me-2"></i> Doenças</a></li>
            </ul>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - CuidaPetWeb - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
