<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CuidaPetWeb</title>
    <!-- Importar fonte Poppins do Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/7.0.0/css/all.min.css">

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CuidaPetWeb.styles.css" asp-append-version="true" />
</head>
<body>
    <!-- Cabeçalho -->
    <header class="bg-green-primary d-flex justify-content-between align-items-center p-3">
        <div class="d-flex align-items-center gap-2">
            <div class="bg-white rounded-circle p-2 d-flex align-items-center justify-content-center"
                 style="width: 60px; height: 60px;">
                <img src="~/assets/logo-header.png" alt="CuidaPet Logo" style="width: 60px; height: 60px;">
            </div>
        </div>
        <div class="d-flex align-items-center gap-4">
            <div class="bg-white rounded-circle p-2 d-flex align-items-center justify-content-center"
                 style="width: 40px; height: 40px;">
                <i class="bi bi-person-circle" style="font-size: 20px;"></i>
            </div>
            <div class="me-2 text-white">
                <div class="fw-bold">Marcos B. Dósea</div>
                <small>Administrador</small>
            </div>
        </div>
    </header>



    <!-- Menu lateral -->
    <nav id="sidebar" class="sidebar">
        <div class="sidebar-header">
            <div class="logo">
                <!-- Seta quando sidebar fechado -->
                <button class="logo-arrow-btn" id="logoArrowBtn">
                    <i class="bi bi-arrow-right"></i>
                </button>
                <span class="logo-text">CuidaPet</span>
            </div>
            <button class="close-btn" id="closeMenu">
                <i class="bi bi-x"></i>
            </button>
        </div>

        <ul>
            <li>
                <a asp-area="" asp-controller="Produto" asp-action="Index">
                    <i class="bi bi-tag-fill"></i>
                    <span>Produtos</span>
                </a>
            </li>
            <li>
                <a asp-area="" asp-controller="Funcionario" asp-action="Index">
                    <i class="bi bi-people-fill"></i>
                    <span>Funcionários</span>
                </a>
            </li>
            <li>
                <a asp-area="" asp-controller="Estabelecimento" asp-action="Index">
                    <i class="bi bi-building-fill"></i>
                    <span>Estabelecimentos</span>
                </a>
            </li>
            <li>
                <a asp-area="" asp-controller="Raca" asp-action="Index">
                    <i class="fa-solid fa-dog"></i>
                    <span>Raças</span>
                </a>
            </li>
            <li>
                <a asp-area="" asp-controller="Vacina" asp-action="Index">
                    <i class="fa-solid fa-syringe"></i>
                    <span>Vacinas</span>
                </a>
            </li>
            <li>
                <a asp-area="" asp-controller="Especie" asp-action="Index">
                    <i class="fa fa-paw"></i>
                    <span>Espécies</span>
                </a>
            </li>
            <li>
                <a asp-area="" asp-controller="Doenca" asp-action="Index">
                    <i class="bi bi-thermometer-half"></i>
                    <span>Doenças</span>
                </a>
            </li>
        </ul>
    </nav>

    <!-- Conteúdo principal -->
    <div class="main-wrapper" id="mainWrapper">
        <div class="container">
            <main role="main" class="pb-3 pt-3" style="margin-bottom: 80px;">
                @RenderBody()
            </main>
        </div>

        <footer class="border-top footer text-muted">
            <div class="container">
                &copy; 2025 - CuidaPetWeb - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            </div>
        </footer>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>