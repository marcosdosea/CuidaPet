@{
	var isAuthenticated = User?.Identity?.IsAuthenticated ?? false;
}
<!DOCTYPE html>
<html lang="pt-br">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<title>@ViewData["Title"] - CuidaPetWeb</title>

	<link rel="stylesheet" href="~/lib/poppins/poppins.css" />
	<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
	<link rel="stylesheet" href="~/lib/bootstrap-icons/font/bootstrap-icons.css" />
	<link rel="stylesheet" href="~/lib/font-awesome/css/all.min.css" />

	<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/css/mobile-design.css" asp-append-version="true" />
	<link rel="stylesheet" href="~/CuidaPetWeb.styles.css" asp-append-version="true" />

	@await RenderSectionAsync("Styles", required: false)
</head>
<body>
	<header class="header-main">
		<div class="header-content">
			<div class="header-left d-none d-md-flex">
				<div class="logo-container">
					<div class="logo-circle-header">
						<img src="~/assets/logo-header.png" alt="CuidaPet Logo" />
					</div>
				</div>
			</div>

			<button class="mobile-menu-btn d-block d-md-none" onclick="toggleSidebar()">
				<i class="bi bi-list"></i>
			</button>

			<div class="header-right">
				@if (isAuthenticated)
				{
					<a asp-controller="Notificacao" asp-action="Index"
					   class="btn btn-link position-relative notification-link"
					   id="notificationLink"
					   title="Minhas Notificações">
						<i class="bi bi-bell text-white fs-4"></i>
						<span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"
							  id="notificationBadge"
							  style="display: none;">
							0
						</span>
					</a>

				}
				<partial name="_LoginPartial" />
			</div>
		</div>
	</header>

	<!-- Sidebar -->
	@if (isAuthenticated)
	{
		<nav id="sidebar" class="sidebar">
			<div class="sidebar-header">
				<div class="logo">
					<button class="logo-arrow-btn" id="logoArrowBtn">
						<i class="bi bi-arrow-right"></i>
					</button>
					<span class="logo-text">CuidaPet</span>
				</div>
				<button class="close-btn" id="closeMenu">
					<i class="bi bi-x"></i>
				</button>
			</div>

			<ul>
				<li><a asp-area="" asp-controller="Produto" asp-action="Index"><i class="bi bi-tag-fill"></i><span>Produtos</span></a></li>
				<li><a asp-area="" asp-controller="Pedidoproduto" asp-action="Index"><i class="bi bi-cart-fill"></i><span>Pedidos</span></a></li>
				<li><a asp-area="" asp-controller="Funcionario" asp-action="Index"><i class="bi bi-people-fill"></i><span>Funcionários</span></a></li>
				<li><a asp-area="" asp-controller="Estabelecimento" asp-action="Index"><i class="bi bi-building-fill"></i><span>Estabelecimentos</span></a></li>
				<li><a asp-area="" asp-controller="Raca" asp-action="Index"><i class="fa-solid fa-dog"></i><span>Raças</span></a></li>
				<li><a asp-area="" asp-controller="Vacina" asp-action="Index"><i class="fa-solid fa-syringe"></i><span>Vacinas</span></a></li>
				<li><a asp-area="" asp-controller="Especie" asp-action="Index"><i class="fa fa-paw"></i><span>Espécies</span></a></li>
				<li><a asp-area="" asp-controller="Doenca" asp-action="Index"><i class="bi bi-thermometer-half"></i><span>Doenças</span></a></li>
				<li><a asp-area="" asp-controller="Pessoa" asp-action="Index"><i class="bi bi-person-fill"></i><span>Tutor</span></a></li>
				<li><a asp-area="" asp-controller="Pet" asp-action="Index"><i class="fa-solid fa-cat"></i><span>Meus Pets</span></a></li>
				<li><a asp-area="" asp-controller="Especialidade" asp-action="Index"><i class="fa-solid fa-stethoscope"></i><span>Especialidades</span></a></li>
				<li><a asp-area="" asp-controller="ConsultarEstabelecimentos" asp-action="Index"><i class="bi bi-search"></i><span>Consultar Estabelecimentos</span></a></li>
				<li>
					<a asp-area="" asp-controller="Notificacao" asp-action="Index">
						<i class="bi bi-bell-fill"></i>
						<span>Notificações</span>
					</a>
				</li>
			</ul>
		</nav>
	}

	<!-- Conteúdo principal -->
	<div class="main-wrapper" id="mainWrapper">
		<div class="main-container">
			<main role="main" class="main-content">
				@RenderBody()
			</main>
		</div>

		<footer class="footer">
			<div class="footer-content">
				&copy; 2025 - CuidaPetWeb - <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
			</div>
		</footer>
	</div>

	<!-- Overlay para mobile -->
	<div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

	<script src="~/lib/jquery/dist/jquery.min.js"></script>
	<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
	<script src="~/js/site.js" asp-append-version="true"></script>
	<script src="~/js/mobile-navigation.js" asp-append-version="true"></script>
	@await RenderSectionAsync("Scripts", required: false)
</body>
</html>