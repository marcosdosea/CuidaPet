@model CuidaPetWeb.Models.EstabelecimentoViewModel

@{
    ViewData["Title"] = "Estabelecimento";
}

<section class="bg-gray-light p-4 rounded">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header bg-gray-medium">
                    <h5 class="card-title mb-0">Informações do @ViewData["title"] #@Model.Id</h5>
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Nome)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Nome)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Telefone)</dt>
                        <dd class="col-sm-9">@Model.Telefone</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Cnpj)</dt>
                        <dd class="col-sm-9">@Model.Cnpj</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Tipo)</dt>
                        <dd class="col-sm-9">
                             @if (Model.Tipo == "P")
                            {
                                <span>PetShop</span>
                            }
                            else if (Model.Tipo == "C")
                            {
                                <span>Clínica</span>
                            }
                            else if (Model.Tipo == "A")
                            {
                                <span>Clínica e PetShop</span>
                            }
                            else
                            {
                                <span>@Model.Tipo</span>
                            }
                        </dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Cidade)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Cidade)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Estado)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Estado)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Bairro)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Bairro)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Logradouro)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Logradouro)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Numero)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Numero)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.Complemento)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.Complemento)</dd>

                        <dt class="col-sm-3">@Html.DisplayNameFor(model => model.IdGerente)</dt>
                        <dd class="col-sm-9">@Html.DisplayFor(model => model.IdGerente)</dd>
                    </dl>
                </div>
                <div class="card-footer">
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil-fill me-2"></i>Editar
                        </a>
                        <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                            <i class="bi bi-trash-fill me-2"></i>Deletar
                        </a>
                        <a asp-action="Index" class="btn btn-secondary">
                            <i class="bi bi-list me-2"></i>Voltar para Lista
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>